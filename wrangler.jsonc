{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "handleliste",
  "main": "./_worker.js",
  "compatibility_date": "2026-05-23",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "kv_namespaces": [
    {
      "binding": "HANDLELISTE_KV",
      "id": "a7fd1016f2a5411d8ac7abc58e680313"
    }
  ]
}
